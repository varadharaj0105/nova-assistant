<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="icon_bg">#0B0918</color>
    <color name="night">#0B0918</color>
    <color name="violet">#8B6CFF</color>
    <color name="pink">#E255C0</color>
    <color name="cyan">#3CC8FF</color>

    <!-- Nova's own look: deep night background with violet/pink accents (same in light and dark mode). -->
    <style name="Theme.Nova" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#B39DFF</item>
        <item name="colorOnPrimary">#1E1238</item>
        <item name="colorPrimaryContainer">#2E2160</item>
        <item name="colorOnPrimaryContainer">#ECE4FF</item>
        <item name="colorSecondary">#F59BD3</item>
        <item name="colorOnSecondary">#3A0E2C</item>
        <item name="colorSecondaryContainer">#2A1B44</item>
        <item name="colorOnSecondaryContainer">#FFE0F2</item>
        <item name="colorTertiary">#7DD8FF</item>
        <item name="android:colorBackground">@color/night</item>
        <item name="colorSurface">@color/night</item>
        <item name="colorOnSurface">#EEEAFB</item>
        <item name="colorOnSurfaceVariant">#ABA3C8</item>
        <item name="colorSurfaceContainerLowest">#08060F</item>
        <item name="colorSurfaceContainerLow">#120F24</item>
        <item name="colorSurfaceContainer">#17132D</item>
        <item name="colorSurfaceContainerHigh">#1E1938</item>
        <item name="colorSurfaceContainerHighest">#262044</item>
        <item name="colorOutline">#5A5285</item>
        <item name="colorOutlineVariant">#2E2752</item>
        <item name="colorError">#FF8A9A</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Group" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
